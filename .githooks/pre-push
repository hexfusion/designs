#!/usr/bin/env bash
# Refuse pushes to main: every change lands through a pull request.
zero=0000000000000000000000000000000000000000
while read -r _ _ remote_ref remote_sha; do
  # Creating main once, on the empty repository, is the only exception.
  if [ "$remote_ref" = refs/heads/main ] && [ "$remote_sha" != "$zero" ]; then
    echo "pre-push: direct pushes to main are not allowed; open a pull request" >&2
    exit 1
  fi
done
exit 0
